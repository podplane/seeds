rityContext.?runAsNonRoot.hasValue()","name":"podRunAsNonRoot"},{"expression":"object.spec.?securityContext.?runAsUser.orValue(-1)","name":"podRunAsUser"}]}}rseedΩôÅ≥âóò¶÷â´M/registry/mutatingadmissionpolicybindings/platform-pod-security-defaults-mapb 0´@Z–{"apiVersion":"admissionregistration.k8s.io/v1","kind":"MutatingAdmissionPolicyBinding","metadata":{"annotations":{"meta.helm.sh/release-name":"platform-rbac","meta.helm.sh/release-namespace":"platform-cluster"},"creationTimestamp":"2015-07-11T04:02:31Z","generation":1,"labels":{"app.kubernetes.io/managed-by":"Helm","helm.toolkit.fluxcd.io/name":"platform-rbac","helm.toolkit.fluxcd.io/namespace":"platform-cluster"},"name":"platform-pod-security-defaults-mapb","uid":"9c40e8a5-5bd9-4d18-ad46-eff5cc3d55c4"},"spec":{"matchResources":{"matchPolicy":"Equivalent","namespaceSelector":{"matchExpressions":[{"key":"pod-security.kubernetes.io/enforce","operator":"NotIn","values":["privileged"]},{"key":"kubernetes.io/metadata.name","operator":"NotIn","values":["kube-system"]}]},"objectSelector":{}},"policyName":"platform-pod-security-defaults-map"}}rseed‡ÌÌ«öÓÃúÑ.¨C/registry/validatingadmissionpolicies/platform-deny-cilium-exec-vap 0¨@Z˛{"apiVersion":"admissionregistration.k8s.io/v1","kind":"ValidatingAdmissionPolicy","metadata":{"annotations":{"meta.helm.sh/release-name":"platform-rbac","meta.helm.sh/release-namespace":"platform-cluster"},"creationTimestamp":"2015-07-11T04:02:31Z","generation":1,"labels":{"app.kubernetes.io/managed-by":"Helm","helm.toolkit.fluxcd.io/name":"platform-rbac","helm.toolkit.fluxcd.io/namespace":"platform-cluster"},"name":"platform-deny-cilium-exec-vap","uid":"6fd48eb3-ae5f-40ea-8005-15bdc95d8ea2"},"spec":{"failurePolicy":"Fail","matchConstraints":{"matchPolicy":"Equivalent","namespaceSelector":{},"objectSelector":{},"resourceRules":[{"apiGroups":[""],"apiVersions":["v1"],"operations":["CONNECT"],"resources":["pods/exec"],"scope":"*"}]},"validations":[{"expression":"!(request.na