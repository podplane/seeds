               \"update\",\n                \"delete\"\n              ],\n              \"groups\": [\n                \"podplane:registry:mirror\"\n              ]\n            },\n            {\n              \"actions\": [\n                \"read\"\n              ],\n              \"groups\": [\n                \"system:masters\",\n                \"podplane:admins\",\n                \"podplane:editors\",\n                \"podplane:operators\",\n                \"podplane:viewers\",\n                \"podplane:registry:admin\",\n                \"podplane:registry:edit\",\n                \"podplane:registry:view\"\n              ]\n            }\n          ]\n        }\n      }\n    },\n    \"address\": \"0.0.0.0\",\n    \"auth\": {\n      \"bearer\": {\n        \"oidc\": [\n          {\n            \"audiences\": [\n              \"default\"\n            ],\n            \"claimMapping\": {\n              \"groups\": \"claims.groups\",\n              \"username\": \"claims.email\"\n            },\n            \"issuer\": \"https://oidc.localhost:62686/oidc\"\n          }\n        ],\n        \"realm\": \"https://default-registry.local/zot/auth/token\",\n        \"service\": \"default-registry.local\"\n      }\n    },\n    \"compat\": [\n      \"docker2s2\"\n    ],\n    \"port\": \"5000\",\n    \"readTimeout\": \"60s\",\n    \"writeTimeout\": \"60s\"\n  },\n  \"log\": {\n    \"level\": \"info\"\n  },\n  \"storage\": {\n    \"dedupe\": false,\n    \"rootDirectory\": \"/var/lib/registry\",\n    \"storageDriver\": {\n      \"accesskey\": \"test\",\n      \"bucket\": \"registry\",\n      \"forcepathstyle\": true,\n      \"name\": \"s3\",\n      \"region\": \"local\",\n      \"regionendpoint\": \"http://10.0.2.2:62685/s3/cache\",\n      \"secretkey\": \"test\",\n      \"secure\": false,\n      \"skipverify\": false\n    }\n  }\n}"},"kind":"ConfigMap","metadata":{"annotations":{"meta.helm.sh/release-name":"platform-zot-registry","meta.helm.sh/release-namespace":"plat