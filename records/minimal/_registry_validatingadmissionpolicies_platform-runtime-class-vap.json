{
  "key": "/registry/validatingadmissionpolicies/platform-runtime-class-vap",
  "value": {
    "apiVersion": "admissionregistration.k8s.io/v1",
    "kind": "ValidatingAdmissionPolicy",
    "metadata": {
      "annotations": {
        "meta.helm.sh/release-name": "platform-runtime",
        "meta.helm.sh/release-namespace": "platform-cluster"
      },
      "creationTimestamp": "2015-07-11T04:02:31Z",
      "generation": 2,
      "labels": {
        "app.kubernetes.io/managed-by": "Helm",
        "helm.toolkit.fluxcd.io/name": "platform-runtime",
        "helm.toolkit.fluxcd.io/namespace": "platform-cluster"
      },
      "name": "platform-runtime-class-vap",
      "uid": "10582cce-170e-48f2-bda5-06a6ff0cde67"
    },
    "spec": {
      "failurePolicy": "Fail",
      "matchConditions": [
        {
          "expression": "!(request.namespace == \"kube-system\" &&\n\n\n  request.userInfo.username.startsWith(\"system:node:\") &&\n  request.userInfo.groups.exists(g, g == \"system:nodes\") &&\n  object.metadata.?annotations[?\"kubernetes.io/config.mirror\"].hasValue())\n",
          "name": "not-static-pod-mirror"
        }
      ],
      "matchConstraints": {
        "matchPolicy": "Equivalent",
        "namespaceSelector": {},
        "objectSelector": {},
        "resourceRules": [
          {
            "apiGroups": [
              ""
            ],
            "apiVersions": [
              "v1"
            ],
            "operations": [
              "CREATE"
            ],
            "resources": [
              "pods"
            ],
            "scope": "*"
          }
        ]
      },
      "validations": [
        {
          "expression": "object.spec.?runtimeClassName.orValue(\"\") in [\"gvisor\", \"runc\"]",
          "messageExpression": "(has(object.spec.runtimeClassName)\n\n\n  ? 'RuntimeClass \"' + object.spec.runtimeClassName + '\" is not supported'\n  : 'Pod has no RuntimeClass after defaulting') +\n'; supported RuntimeClasses are \"gvisor\" (the default when omitted) and \"runc\".'\n"
        },
        {
          "expression": "object.spec.?runtimeClassName.orValue(\"\") != \"runc\" || namespaceObject.metadata.?labels[?\"runtime.podplane.dev/runc\"].orValue(\"\") == \"allowed\"\n",
          "messageExpression": "'RuntimeClass \"runc\" requires namespace \"' + request.namespace + '\" to have the label ' + 'runtime.podplane.dev/runc=allowed, which only a cluster administrator can grant. ' + 'Otherwise set runtimeClassName to \"gvisor\", which is also the default outside platform runc namespaces.'\n",
          "reason": "Forbidden"
        }
      ]
    }
  }
}
